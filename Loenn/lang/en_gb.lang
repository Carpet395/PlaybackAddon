entities.playback/piano.placements.name.Piano_FourShift=Piano (Fourway Shift)
entities.playback/piano.placements.name.Piano_Eight=Piano (Eightway)
entities.playback/piano.placements.name.Piano_EightShift=Piano (Eightway Shift)

entities.playback/piano.placements.description.Piano_Four=A Piano with 5 possible notes.
entities.playback/piano.placements.description.Piano_FourShift=A Piano with 5 possible notes + 5 shift notes.
